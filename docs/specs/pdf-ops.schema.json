{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knit.local/docs/specs/pdf-ops.schema.json",
  "title": "Knit pdf-ops IPC & Data Contract",
  "description": "Machine-readable schema and Tauri IPC / Rust crate contract for Knit PDF Merge & Split (v0.2.0). Derived directly from crates/knit-pdf/src/models.rs, crates/knit-pdf/src/ops.rs, src-tauri/src/lib.rs, and src/types/ipc.ts.",
  "version": "0.2.0",
  "x-llms-index": "/llms.txt",
  "x-ipc-operations": [
    {
      "operationId": "inspectPdfFile",
      "tauriCommand": "pdf_inspect",
      "rustEntrypoint": "knit_pdf::inspect_pdf",
      "summary": "Inspect PDF page count, byte size, and /Outlines bookmarks using mmap stream filtering.",
      "description": "Maps the PDF read-only via memmap2 and strips heavy image/font streams with filter_inspect_objects so multi-GB files open immediately without RAM spikes.",
      "deprecated": false,
      "parameters": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "description": "Absolute filesystem path to the PDF file." }
        }
      },
      "returns": { "$ref": "#/$defs/PdfInfo" },
      "errors": [
        { "pattern": "Path not found: <path>", "cause": "Target PDF does not exist on disk." },
        { "pattern": "Failed to open PDF: <err>", "cause": "Malformed PDF header or xref table." }
      ]
    },
    {
      "operationId": "renderPdfThumbFile",
      "tauriCommand": "render_pdf_thumb_file",
      "rustEntrypoint": "knit_pdf::render_pdf_thumbnail_jpeg",
      "summary": "Render and disk-cache a JPEG page thumbnail using HAYRO_PDF_CACHE and return the local file path.",
      "description": "Uses thumb_semaphore (2..6 permits) and a 4-entry LRU Arc<Pdf> mmap cache. Wrap the returned path with convertFileSrc() for virtualized grid rendering.",
      "deprecated": false,
      "parameters": {
        "type": "object",
        "required": ["path", "pageIndex", "maxWidth"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "pageIndex": { "type": "integer", "minimum": 0, "description": "0-based PDF page index." },
          "maxWidth": { "type": "integer", "minimum": 1, "default": 260 }
        }
      },
      "returns": { "type": "string", "description": "Absolute path to cached .jpg thumbnail on disk." }
    },
    {
      "operationId": "renderPdfPagePreviewFile",
      "tauriCommand": "render_pdf_page_preview_file",
      "rustEntrypoint": "knit_pdf::render_pdf_thumbnail",
      "summary": "Render a high-priority PNG page preview under preview_semaphore (2 isolated permits).",
      "description": "Isolated from background thumbnail rendering so double-click ZoomPanViewport modals open immediately even while hundreds of grid thumbnails are queued.",
      "deprecated": false,
      "parameters": {
        "type": "object",
        "required": ["path", "pageIndex", "maxWidth"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "pageIndex": { "type": "integer", "minimum": 0 },
          "maxWidth": { "type": "integer", "minimum": 1, "default": 1400 }
        }
      },
      "returns": { "type": "string", "description": "Absolute path to cached .png preview on disk." }
    },
    {
      "operationId": "renderPdfThumbBase64",
      "tauriCommand": "render_pdf_thumb",
      "rustEntrypoint": "knit_pdf::render_pdf_thumbnail",
      "summary": "Legacy Base64 PNG PDF thumbnail renderer (prefer renderPdfThumbFile).",
      "deprecated": true,
      "x-replacement": "renderPdfThumbFile",
      "parameters": {
        "type": "object",
        "required": ["path", "pageIndex", "maxWidth"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "pageIndex": { "type": "integer", "minimum": 0 },
          "maxWidth": { "type": "integer", "minimum": 1, "default": 300 }
        }
      },
      "returns": { "type": "string", "description": "Base64-encoded PNG bytes." }
    },
    {
      "operationId": "readPdfFileBytes",
      "tauriCommand": "read_pdf_file_bytes",
      "summary": "Read raw PDF file bytes as an IPC ArrayBuffer Response.",
      "deprecated": false,
      "parameters": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" }
        }
      },
      "returns": { "type": "string", "format": "binary" }
    },
    {
      "operationId": "releasePdfCachedFiles",
      "tauriCommand": "pdf_release_cached_files",
      "rustEntrypoint": "knit_pdf::evict_pdf_reader_cache_paths",
      "summary": "Evict specific file paths from HAYRO_PDF_CACHE and call trim_process_heap().",
      "description": "Releases read-only memmap2 handles when removing individual PDFs or clearing the workspace (important on Windows to avoid file locks).",
      "deprecated": false,
      "parameters": {
        "type": "object",
        "required": ["paths"],
        "additionalProperties": false,
        "properties": {
          "paths": { "type": "array", "items": { "type": "string" } }
        }
      },
      "returns": { "type": "null" }
    },
    {
      "operationId": "mergePdfFiles",
      "tauriCommand": "pdf_merge",
      "rustEntrypoint": "knit_pdf::merge_pdfs",
      "summary": "Stream-merge pages from 1+ PDF files with per-page rotation and /Outlines remapping.",
      "description": "Opens at most 1 source Document at a time, materializes inherited page attributes, streams directly via StreamingPdfWriter (256 KiB BufWriter -> .tmp), drops each doc and trims heap before opening the next.",
      "deprecated": false,
      "parameters": {
        "type": "object",
        "required": ["jobId", "config"],
        "additionalProperties": false,
        "properties": {
          "jobId": { "type": "string", "format": "uuid" },
          "config": { "$ref": "#/$defs/PdfMergeConfig" },
          "onEvent": { "description": "Optional Tauri Channel<JobEvent> throttled at ~10 Hz." }
        }
      },
      "returns": { "$ref": "#/$defs/PdfBuildResult" },
      "errors": [
        { "pattern": "Can it nhat 1 file PDF de gop", "cause": "Empty config.inputs." },
        { "pattern": "file_index <n> khong hop le", "cause": "PageSelection.file_index out of bounds." },
        { "pattern": "page_index <p> khong ton tai trong file <f>", "cause": "PageSelection.page_index exceeds source PDF page_count." },
        { "pattern": "Job cancelled by user", "cause": "Cancelled via cancel_job; TempFilesGuard deletes .tmp artifacts." }
      ]
    },
    {
      "operationId": "splitPdfFile",
      "tauriCommand": "pdf_split",
      "rustEntrypoint": "knit_pdf::split_pdf",
      "summary": "Split a single PDF into one or more PDF files according to PdfSplitRule.",
      "deprecated": false,
      "parameters": {
        "type": "object",
        "required": ["jobId", "inputPath", "outputDir", "stem", "rule"],
        "additionalProperties": false,
        "properties": {
          "jobId": { "type": "string", "format": "uuid" },
          "inputPath": { "type": "string" },
          "outputDir": { "type": "string" },
          "stem": { "type": "string" },
          "rule": { "$ref": "#/$defs/PdfSplitRule" },
          "onEvent": { "description": "Optional Tauri Channel<JobEvent>." }
        }
      },
      "returns": { "$ref": "#/$defs/PdfBuildResult" },
      "errors": [
        { "pattern": "PDF is empty (0 pages)", "cause": "Source PDF has 0 pages." },
        { "pattern": "max_mb phai lon hon 0", "cause": "MaxBytes rule received <= 0.0." },
        { "pattern": "Chua co trang nao trong cac section dau ra", "cause": "CustomGroups has no non-empty group." }
      ]
    },
    {
      "operationId": "splitMultiPdfFiles",
      "tauriCommand": "pdf_split_multi",
      "rustEntrypoint": "knit_pdf::split_multi_pdf",
      "summary": "Split across multiple PDFs using CustomGroups cross-file sections or batch-split each file by rule.",
      "deprecated": false,
      "parameters": {
        "type": "object",
        "required": ["jobId", "inputs", "stems", "outputDir", "rule"],
        "additionalProperties": false,
        "properties": {
          "jobId": { "type": "string", "format": "uuid" },
          "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "stems": { "type": "array", "items": { "type": "string" } },
          "outputDir": { "type": "string" },
          "rule": { "$ref": "#/$defs/PdfSplitRule" },
          "onEvent": { "description": "Optional Tauri Channel<JobEvent>." }
        }
      },
      "returns": { "$ref": "#/$defs/PdfBuildResult" }
    },
    {
      "operationId": "cancelJob",
      "tauriCommand": "cancel_job",
      "summary": "Cooperatively cancel an active pdf_merge, pdf_split, or pdf_split_multi job.",
      "deprecated": false,
      "parameters": {
        "type": "object",
        "required": ["jobId"],
        "additionalProperties": false,
        "properties": {
          "jobId": { "type": "string", "format": "uuid" }
        }
      },
      "returns": { "type": "null" }
    }
  ],
  "$defs": {
    "BookmarkNode": {
      "type": "object",
      "required": ["title", "target_page_index", "children"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "target_page_index": { "type": "integer", "minimum": 0 },
        "children": { "type": "array", "default": [], "items": { "$ref": "#/$defs/BookmarkNode" } }
      }
    },
    "PdfInfo": {
      "type": "object",
      "required": ["path", "page_count", "file_size_bytes", "bookmarks"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "page_count": { "type": "integer", "minimum": 0 },
        "file_size_bytes": { "type": "integer", "minimum": 0 },
        "bookmarks": { "type": "array", "items": { "$ref": "#/$defs/BookmarkNode" } }
      }
    },
    "PageSelection": {
      "type": "object",
      "required": ["file_index", "page_index"],
      "additionalProperties": false,
      "properties": {
        "file_index": { "type": "integer", "minimum": 0, "description": "0-based index into inputs array." },
        "page_index": { "type": "integer", "minimum": 0, "description": "0-based page index within that PDF." },
        "rotation_deg": { "type": "integer", "enum": [0, 90, 180, 270], "default": 0, "description": "Additional clockwise rotation in degrees." }
      }
    },
    "PdfMergeConfig": {
      "type": "object",
      "required": ["inputs", "selected_pages", "output_path", "preserve_bookmarks"],
      "additionalProperties": false,
      "properties": {
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "selected_pages": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/PageSelection" } },
            { "type": "null" }
          ],
          "default": null
        },
        "output_path": { "type": "string" },
        "preserve_bookmarks": { "type": "boolean", "default": true },
        "custom_bookmarks": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/BookmarkNode" } },
            { "type": "null" }
          ],
          "default": null
        }
      }
    },
    "PdfSplitGroup": {
      "type": "object",
      "required": ["name", "pages"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Section output filename stem (sanitized via sanitize_split_group_name; duplicates get _2, _3)." },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/PageSelection" } }
      }
    },
    "PdfSplitRule": {
      "description": "Tagged union selecting one of the 5 PDF splitting modes.",
      "oneOf": [
        {
          "type": "object",
          "required": ["rule", "ranges"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "page_ranges" },
            "ranges": { "type": "string", "example": "1-3, 5, 8-6" }
          }
        },
        {
          "type": "object",
          "required": ["rule", "n"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "every_n_pages" },
            "n": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["rule", "page_indices"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "extract_selected" },
            "page_indices": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }
          }
        },
        {
          "type": "object",
          "required": ["rule", "max_mb"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "max_bytes" },
            "max_mb": { "type": "number", "exclusiveMinimum": 0.0 }
          }
        },
        {
          "type": "object",
          "required": ["rule", "groups"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "custom_groups" },
            "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/PdfSplitGroup" } }
          }
        }
      ],
      "discriminator": { "propertyName": "rule" }
    },
    "PdfBuildResult": {
      "type": "object",
      "required": ["output_files", "total_pages", "total_bytes", "passthrough_pages"],
      "additionalProperties": false,
      "properties": {
        "output_files": { "type": "array", "items": { "type": "string" } },
        "total_pages": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "passthrough_pages": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
